# ── Runtime ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database (PostgreSQL) ───────────────────────────────
# Pooled connection used by the app (on Neon/Vercel Postgres use the pooled URL
# and append ?pgbouncer=true&connection_limit=1 for serverless).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/stockhub?schema=public
# Direct (non-pooled) connection used only by `prisma migrate`.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/stockhub?schema=public

# ── Auth (use long random values, e.g. `openssl rand -hex 48`) ──
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30

# ── HTTP ────────────────────────────────────────────────
# Comma separated list of allowed browser origins. Desktop clients send no Origin header.
CORS_ORIGINS=http://localhost:3000
# Set to 1 when running behind a proxy (Vercel, Nginx) so rate limiting sees the real IP.
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20
LOG_LEVEL=info

# ── Mail (optional; required in production for password reset) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="StockHub <no-reply@example.com>"
APP_RESET_PASSWORD_URL=

# ── Seed (development only) ─────────────────────────────
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=
SEED_DEFAULT_PASSWORD=
